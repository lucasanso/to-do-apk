<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="voice" android:enabled="true" android:icon="@drawable/ic_shortcut_voice"
        android:shortcutShortLabel="@string/shortcut_voice">
        <intent android:action="com.taskflow.VOICE"
            android:targetPackage="com.lucasanso.taskflow"
            android:targetClass="com.taskflow.presentation.voice.VoiceCaptureActivity" />
    </shortcut>
    <shortcut android:shortcutId="quick_add" android:enabled="true" android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent android:action="com.taskflow.TYPE"
            android:targetPackage="com.lucasanso.taskflow"
            android:targetClass="com.taskflow.presentation.voice.VoiceCaptureActivity" />
    </shortcut>
</shortcuts>
